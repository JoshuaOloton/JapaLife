// JapaLife ledger schema.
//
// Rules this schema encodes (see CLAUDE.md, "The economy is a multi-currency ledger"):
//  - No mutable `balance` column. Every movement of money is an immutable
//    `Transaction` row. A wallet's balance is the `*BalanceAfter` of the latest
//    row that touches it, written while holding a lock on the wallet row.
//  - Amounts are BigInt in the smallest unit (kobo, pence, cents). Never floats.
//  - A Transaction moves money between two wallets of the SAME currency; the
//    composite foreign keys make a mismatch impossible at the database level.
//  - Faucets and sinks are movements to/from SYSTEM wallets, so every movement
//    has a real `from` and `to` and total money in the system stays auditable.
//
// Rules Prisma cannot express live in the migration SQL (init_ledger):
//  - Transaction.amount is > 0 and <= 10^15 (MAX_WALLET_BALANCE)
//  - Transaction.fromWalletId <> Transaction.toWalletId
//  - Wallet shape: PLAYER has playerId and no systemKey; SYSTEM the reverse
//  - Conversion amounts, rate and spread are in range
//  - A trigger rejects UPDATE and DELETE on Transaction: the ledger is append-only
//  - Nothing cascades or nulls out on delete: ledger links are never lost
// PLAYER wallet balances never go negative. That cannot be a single-table CHECK
// (SYSTEM wallets legitimately go negative as faucets), so the ledger service
// enforces it under the wallet lock and an audit test re-verifies it.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  NGN
  GBP
  CAD
}

enum WalletKind {
  PLAYER
  SYSTEM
}

enum ConversionChannel {
  BANK
  FINTECH
  STREET
}

model Player {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())

  wallets      Wallet[]
  conversions  Conversion[]
  state        PlayerState?
  shifts       Shift[]
  eventFirings EventFiring[]
  balanceFlags BalanceFlag[]
  eventChoices EventChoice[]
  inbox        InboxMessage[]
  appearance   PlayerAppearance?
}

// ---- Character (Slice 11d) ---------------------------------------------------
// Cosmetic avatar data, not money and not personal data about the real person:
// catalog ids only (content/characters/catalog.json). No row means the player
// has not made a character yet, so the client opens the creator.

model PlayerAppearance {
  playerId     String   @id
  body         String
  skinTone     String
  hair         String
  hairColour   String
  outfit       String
  outfitColour String
  updatedAt    DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Restrict)
}

// ---- Game state (Phase 1, Slice 4) -------------------------------------------
// Not money: nothing here touches the ledger tables. Every timer is a timestamp
// on the server clock, so time passes while the player is offline.

model PlayerState {
  playerId        String   @id
  /// Meter values as of `statsAt`. The current value is computed from the
  /// elapsed real time and the rates in content/economy/needs.json.
  hunger          Float
  energy          Float
  morale          Float
  /// Hours of generator running time left in the tank, as of `statsAt`.
  generatorFuelHours Float
  statsAt         DateTime
  /// Relationship with family back home, 0-100. Changes only through events.
  family          Float
  /// When the next rent payment is due.
  rentDueAt       DateTime
  /// When the next late fee is charged if rent is still unpaid: the end of the
  /// grace period, then every few days after. Moves on when a fee is charged or rent is paid.
  lateFeeDueAt    DateTime
  /// Random events have been evaluated up to this moment.
  eventsCheckedAt DateTime
  createdAt       DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@index([lateFeeDueAt])
}

/// Something that happened to the player, kept so they see it when they come
/// back (time passes while they are offline). The text is stored as shown at
/// the time. Only the latest few per player are kept.
model InboxMessage {
  id        String    @id @default(uuid(7))
  playerId  String
  /// "event", "shift_paid" or "rent" (NOTICE_KINDS in packages/shared).
  kind      String
  title     String
  message   String
  /// Game time it happened.
  createdAt DateTime
  /// Set when the player saw it, as a toast or by opening the inbox.
  readAt    DateTime?

  player Player @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@index([playerId, createdAt])
  @@index([playerId, readAt])
}

/// One work shift. Energy is spent at the start; pay is credited through the
/// ledger once `endsAt` has passed (reference `shift:<id>`), then `paidAt` is set.
model Shift {
  id        String    @id @default(uuid(7))
  playerId  String
  jobId     String
  /// Pay agreed when the shift started (low morale pays less). Null on shifts
  /// from before this column existed, which pay the job's full rate.
  payKobo   BigInt?
  startedAt DateTime
  endsAt    DateTime
  /// The city's calendar day the shift started on ("YYYY-MM-DD"), for the daily cap.
  dayKey    String
  paidAt    DateTime?

  player Player @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@index([playerId, dayKey])
  @@index([paidAt, endsAt])
}

/// A random event that happened to a player. `endsAt` is set for events with a
/// duration (power cut, price rise). `amountKobo` is set for money events.
model EventFiring {
  id         String    @id @default(uuid(7))
  playerId   String
  eventId    String
  firedAt    DateTime
  endsAt     DateTime?
  amountKobo BigInt?

  player Player @relation(fields: [playerId], references: [id], onDelete: Restrict)
  choice EventChoice?

  @@index([playerId, eventId, firedAt])
  @@index([playerId, endsAt])
}

/// An event that asks the player to choose (black tax: pay or decline). Kept
/// here, not in the room, so the question waits while the player is offline.
model EventChoice {
  id         String    @id @default(uuid(7))
  playerId   String
  firingId   String    @unique
  eventId    String
  /// How much is asked for. Paying debits exactly this.
  amountKobo BigInt
  /// Which of the event's `asks` texts was picked.
  variant    Int
  askedAt    DateTime
  /// After this the request counts as declined.
  expiresAt  DateTime
  /// "pay", "decline" or "expired". Null while waiting for an answer.
  answer     String?
  answeredAt DateTime?

  player Player      @relation(fields: [playerId], references: [id], onDelete: Restrict)
  firing EventFiring @relation(fields: [firingId], references: [id], onDelete: Restrict)

  @@index([playerId, answer])
  @@index([answer, expiresAt])
}

// ---- Monitoring (Phase 1, Slice 6) -------------------------------------------
// Not money: nothing here changes a balance. A flag is a lead for a human to
// review, never an automatic penalty (decided 2026-10-16).

/// Money a player received faster than the rules in content/ allow: the sum
/// credited for one reason over a trailing real-time window exceeded its ceiling.
/// One row per player, currency, reason and Lagos day, keeping the worst amount seen.
model BalanceFlag {
  id               String   @id @default(uuid(7))
  playerId         String
  currency         Currency
  /// The ledger reason that went over its ceiling (a faucet, or e.g. player_transfer).
  reason           String
  /// Smallest unit. Sum credited for `reason` within the window.
  receivedInWindow BigInt
  /// Smallest unit. The most the rules allow for `reason` within the window.
  ceiling          BigInt
  windowStart      DateTime
  windowEnd        DateTime
  /// Lagos calendar day ("YYYY-MM-DD") the flag was raised on.
  dayKey           String
  createdAt        DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([playerId, currency, reason, dayKey])
  @@index([createdAt])
}

model Wallet {
  id        String     @id @default(uuid(7))
  kind      WalletKind
  currency  Currency
  /// Set for PLAYER wallets only.
  playerId  String?
  /// Set for SYSTEM wallets only, e.g. "faucet", "sink", "fx".
  systemKey String?
  createdAt DateTime   @default(now())

  player Player? @relation(fields: [playerId], references: [id], onDelete: Restrict)

  sent     Transaction[] @relation("TransactionFrom")
  received Transaction[] @relation("TransactionTo")

  // One wallet per player per currency; one system wallet per key per currency.
  @@unique([playerId, currency])
  @@unique([systemKey, currency])
  // Lets Transaction reference (wallet, currency) so currencies cannot mismatch.
  @@unique([id, currency])
}

model Transaction {
  /// Monotonic. For any one wallet, rows are inserted under that wallet's lock,
  /// so the highest id touching a wallet is its latest movement.
  id BigInt @id @default(autoincrement())

  fromWalletId String
  toWalletId   String
  currency     Currency
  /// Smallest unit, always > 0 (CHECK in migration).
  amount       BigInt

  /// What the movement was for. One of LEDGER_REASONS in packages/shared;
  /// validated in the ledger service so adding a reason needs no migration.
  reason    String
  /// Idempotency key. A retried request reuses it and cannot apply twice.
  reference String   @unique
  createdAt DateTime @default(now())

  /// Running balances of each wallet immediately after this movement.
  fromBalanceAfter BigInt
  toBalanceAfter   BigInt

  /// Set on the two legs of a currency conversion.
  conversionId String?

  fromWallet Wallet      @relation("TransactionFrom", fields: [fromWalletId, currency], references: [id, currency])
  toWallet   Wallet      @relation("TransactionTo", fields: [toWalletId, currency], references: [id, currency])
  conversion Conversion? @relation(fields: [conversionId], references: [id], onDelete: Restrict)

  @@index([fromWalletId, id])
  @@index([toWalletId, id])
  @@index([conversionId])
  @@index([reason, createdAt])
}

/// A currency conversion. Its two ledger legs are Transactions linked by
/// `conversionId`: player -> fx wallet in `fromCurrency`, then fx wallet ->
/// player in `toCurrency`. Records the rate and spread actually used.
model Conversion {
  id           String            @id @default(uuid(7))
  playerId     String
  channel      ConversionChannel
  fromCurrency Currency
  toCurrency   Currency
  fromAmount   BigInt
  toAmount     BigInt
  /// Mid-market rate before spread, scaled by 1_000_000 (integers only).
  midRateMicro BigInt
  /// Channel spread in basis points (1 bp = 0.01%).
  spreadBps    Int
  createdAt    DateTime          @default(now())

  player       Player        @relation(fields: [playerId], references: [id])
  transactions Transaction[]

  @@index([playerId, createdAt])
}
