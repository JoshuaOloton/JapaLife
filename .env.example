# Copy to .env for local development. Never commit real secrets.

# Postgres credentials, read by docker-compose.yml
DB_USER=japalife
DB_NAME=japalife
DB_PASSWORD=change-me

# Must match the DB_* values above
DATABASE_URL=postgresql://japalife:change-me@localhost:5432/japalife
REDIS_URL=redis://localhost:6379

# Dev only: run game time this many times faster (60 = one real minute is one
# game hour). The server refuses to start with it set when NODE_ENV=production.
# GAME_CLOCK=60

SERVER_PORT=2567
NEXT_PUBLIC_SERVER_URL=ws://localhost:2567
